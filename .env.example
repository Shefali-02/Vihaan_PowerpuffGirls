# Munshi Environment Configuration
# Copy this to .env and fill in real values

# ═══════════════════════════════════════════════════════════════════════
# PRUNE API (CRITICAL - Member 2 must obtain these)
# ═══════════════════════════════════════════════════════════════════════
# Get these from hackathon organizers or Prune documentation
# If not available, the system will fall back to PruneMock automatically

PRUNE_BASE_URL=https://api.withprune.com/v1
PRUNE_API_KEY=prune_qmaHI-kANbHASe-bAgk_e7UA7HHjh0iQ
PRUNE_MODEL=default

# ═══════════════════════════════════════════════════════════════════════
# DATABASE (Member 3 will configure)
# ═══════════════════════════════════════════════════════════════════════
DATABASE_URL=sqlite:///./munshi.db

# ═══════════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════════
DEBUG=true
LOG_LEVEL=info
WORKSPACE_ID=demo-workspace-001

# ═══════════════════════════════════════════════════════════════════════
# AI CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
AI_CONFIDENCE_THRESHOLD=0.80
AI_TYPE_CONFIDENCE_THRESHOLD=0.70
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=30

