FROM node:22-slim
WORKDIR /chain
COPY chain/package.json chain/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY chain/hardhat.config.js ./
COPY chain/contracts ./contracts
COPY chain/scripts ./scripts
COPY chain/test ./test
# SOLC_OFFLINE=1 compiles with the bundled solcjs (no download from binaries.soliditylang.org)
ENV SOLC_OFFLINE=1
RUN npx hardhat compile
EXPOSE 8545
CMD ["npx", "hardhat", "node", "--hostname", "0.0.0.0"]
