# --- database: Postgres in docker; SQLite fallback when unset (sqlite:///./munshi.db) ---
DATABASE_URL=postgresql+psycopg://munshi:munshi@localhost:5432/munshi
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720

# --- AI: mock (default, deterministic fixtures) | prune (assumed OpenAI-style contract, unverified) ---
LLM_MODE=mock
PRUNE_BASE_URL=https://prune.example
PRUNE_API_KEY=
PRUNE_MODEL=prune-default
PRUNE_TIMEOUT_S=30

# --- anchoring: hardhat (falls back to MOCK if node unreachable) | mock ---
ANCHOR_MODE=hardhat
CHAIN_RPC_URL=http://127.0.0.1:8545
ANCHOR_PRIVATE_KEY=            # empty = first unlocked Hardhat account (local only; never commit keys)
DEPLOYMENT_FILE=./chain/deployments/local.json

# --- confidence gate ---
CONFIDENCE_THRESHOLD=0.85
AUTO_DRAFT_AMOUNT_LIMIT_PAISE=10000000   # Rs 1,00,000

# --- misc ---
PUBLIC_BASE_URL=http://localhost:3000    # frontend origin; QR codes point to {PUBLIC_BASE_URL}/verify
CORS_ORIGINS=*
EXPORT_OPENAPI=true
